executor {
    name = 'slurm'
    queueSize = 20   // máximo de jobs simultâneos na fila (evita AssocMaxSubmitJobLimit)
}

process {
    executor = 'slurm'
    queue = 'sequana_cpu'

    // Padrão para processos sem configuração própria
    time = '1h'
    memory = '2 GB'

    withName: 'ENCONTRAR_PONTOS_ESTACIONARIOS' {
        cpus = 1
        time = '1h'
    }

    withName: 'DIVIDIR_PONTOS' {
        cpus = 1
        time = '15m'
        executor = 'local'
    }

    withName: 'GERAR_LANDSCAPE' {
        cpus = 1
        memory = '2 GB'
        time = '6h'
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: 'PLOTAR_GRAFICO' {
        cpus = 4
        memory = '8 GB'
        time = '2h'
        clusterOptions = '--nodes=1 --ntasks=4 --ntasks-per-node=4 --cpus-per-task=1'
    }
}
